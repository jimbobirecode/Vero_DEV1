# ---- Club identity (change per customer) ----
CLUB_NAME=Walpole Country Club
CLUB_ID_SLUG=walpole-cc

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
CLUB_ID=

# ---- App ----
SURVEY_BASE_URL=https://vero-walpole.onrender.com
PORT=3000

# ---- Cron secret (protects /api/cron/* endpoints) ----
CRON_SECRET=

# ---- Daily digest (hour of day 0-23, default 7) ----
DIGEST_HOUR=7

# ---- AI analysis ----
ANTHROPIC_API_KEY=

# ---- Sendly SMS ----
SENDLY_API_KEY=
SENDLY_FROM_NUMBER=

# ---- SendGrid email (required for surveys, alerts, and digest emails) ----
# SENDGRID_FROM_EMAIL must match a verified Sender Identity in your SendGrid account.
# Verify at: https://app.sendgrid.com/settings/sender_auth or Settings > Sender Authentication.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ---- SendGrid dynamic templates (optional — falls back to plain text if blank) ----
SENDGRID_TEMPLATE_ID=
SENDGRID_REMINDER_TEMPLATE_ID=

# Optional: comma-separated origins allowed to call the API cross-origin.
# Leave empty for same-origin only (the default and recommended setting).
ALLOWED_ORIGINS=

# SendGrid link tracking. Click tracking rewrites every link through your
# branded tracking domain; if that domain's certificate is wrong the survey
# link and the unsubscribe link both break, and HSTS on the parent domain
# prevents the member continuing past the warning. Left off by default.
# Set to true only once the branded domain serves a valid certificate.
SENDGRID_CLICK_TRACKING=false
SENDGRID_OPEN_TRACKING=true
